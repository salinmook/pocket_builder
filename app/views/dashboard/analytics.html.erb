<h2>Analytics</h2>
<hr>

<h3>Revenue by <%= @period.capitalize %></h3>
<div style="margin-bottom: 15px;">
    <%= link_to "Day", store_dashboard_analytics_path(@store, period: "day"), 
    style: @period == "day" ? "font-weight: bold;" : "" %> |
    <%= link_to "Month", store_dashboard_analytics_path(@store, period: "month"),
    style: @period == "month" ? "font-weight: bold;" : "" %> |
    <%= link_to "Year", store_dashboard_analytics_path(@store, period: "year"),
    style: @period == "year" ? "font-weight: bold;" : "" %>
</div>
    <%= line_chart @monthly_revenue, height: "400px", prefix: "€", discrete: true %>

<hr>

<h3>Raw Data</h3>

<table>
<tr>
    <th><%= @period.capitalize %></th>
    <th>Revenue</th>
</tr>
<% @monthly_revenue.each do | label, revenue| %>
<tr>
    <td><%= label %></td>
    <td><%= revenue %></td>
</tr>
<% end %>
</table>
