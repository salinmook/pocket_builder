<%= form_with model: [@store, coupon], local: true do |f| %>
    <% if coupon.errors.any? %>
        <div style="color:red;">
            <ul>
                <% coupon.errors.full_messages.each do |msg| %>
                    <li><%= msg %></li>
                <% end %>
            </ul>
        </div>
        <% end %>

        <p>
            <%= f.label :code %><br>
            <%= f.text_field :code, placeholder: "SUMMER10" %>
        </p>

        <p>
            <%= f.label :discount_type %><br>
            <%= f.select :discount_type, [["Percentage", "percentage"],
            ["Fixed Amount", "fixed_amount"], ["Free Shipping", "free_shipping"]] %>
        </p>

        <p>
            <%= f.label :discount_value, "Discount Value (% or €)" %><br>
            <%= f.number_field :discount_value, step: 0.01 %>
        </p>

        <p>
            <%= f.label :minimum_order_amount, "Minimum Order Amount (€, optional)" %><br>
            <%= f.number_field :minimum_order_amount, step: 0.1 %>
        </p>

        <p>
            <%= f.label :starts_at, "Start At (optional)" %><br>
            <%= f.datetime_field :starts_at %>
        </p>

        <p>
            <%= f.label :ends_at, "Ends At (optional)" %><br>
            <%= f.datetime_field :ends_at %>
        </p>

        <p>
            <%= f.label :usage_limit, "Usage Limit (optional)" %><br>
            <%= f.number_field :usage_limit %>
        </p>

        <p>
            <%= f.label :active %>
            <%= f.check_box :active %>
        </p>
        <%= f.submit "Save Coupon" %>
        <% end %>
                    
        
