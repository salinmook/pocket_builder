<h1>Orders</h1>
<h2>Pending Orders</h2>
<table>
<tr>
<th>ID</th>
<th>Date</th>
<th>Items</th>
<th>Total</th>
<th>Status</th>
<th></th>
</tr>

<% @pending_orders.each do |order| %>
    <tr>
        <td><%= order.id %></td>
        <td><%= order.created_at.strftime("%d/%m/%Y") %></td>
        <td><% order.order_items.each do |item| %>
            <div><%= item.product.title %> x <%= item.quantity %></div>
            <% end %>
        </td>
     
        <td>€<%= order.order_items.sum { |i| i.price * i.quantity } %></td>
        <td><%= order.status %></td>
        <td><%= button_to "Ship", ship_order_path(order), method: :patch %>
            <%= button_to "Cancel", cancel_order_path(order), method: :patch,
    data: {
    turbo_confirm: "Cancel this order?"
    } %></td>
     </tr>
    </tr>
    <% end %>
    </table>
    
    <hr>

