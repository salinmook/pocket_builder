<h2>Customers</h2>
<table>
<tr>
    <th>Name</th>
    <th>Email</th>
    <th>Total Orders</th>
</tr>

<% @customers.each do |customer| %>
<tr>
    <td><%= customer.email.split("@").first %></td>
    <td><%= customer.email %></td>
    <th><%= @store.orders.where(user: customer).count %></td>
</tr>
<% end %>
</table>
