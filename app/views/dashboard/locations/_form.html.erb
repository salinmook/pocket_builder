<%= form_with model: [@store, location], url: location.persisted? ? store_location_path(@store, location) : store_locations_path(@store), local: true, data: { controller: "google-map", google_map_lat_value: location.latitude || 0, google_map_lng_value: location.longitude || 0 } do |f| %>
    <% if location.errors.any? %>
        <div style="color:red;">
            <ul>
                <% location.errors.full_messages.each do |msg| %>
                    <li><%= msg %></li>
                <% end %>
            </ul>
        </div>
    <% end %>
    <p>
        <%= f.label :label, "Label (e.g. Main Branch, Downtown)" %><br>
        <%= f.text_field :label %>
    </p>

    <p>
        <%= f.label :address %><br>
        <%= f.text_area :address, rows: 2, data: { google_map_target: "address" } %>
    </p>

    <p>
        <%= f.label :phone %><br>
        <%= f.text_field :phone %>
    </p>

    <p>Click on the map or drag the pin to set the exact location:</p>
    <div data-google-map-target="map" style="width:100%; height:400px; border:1px solid #ccc;"></div>

    <%= f.hidden_field :latitude, data: { google_map_target: "latitude" } %>
    <%= f.hidden_field :longitude, data: { google_map_target: "longitude" } %>

    <p>
        <%= f.submit "Save Location" %>
    </p>
<% end %>