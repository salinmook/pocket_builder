<h1>Products Dashboard</h1>
<!--BACK-->
<p><%= link_to "Back to Dashboard", store_dashboard_path(@store) %></p>

<hr>

<!--SEARCH-->
<%= form_with url: store_dashboard_products_path(@store),
method: :get,
local: true do %>
    <input type="text"
           name="query"
           value="<%= params[:query] %>"
           placeholder="Search product..." />
           <button type="submit">Search</button>           
<% end %>
<hr>
<!--PRODUCTS LIST-->
<table border="1" cellpadding="10">
<tr>
    <th>Product</th>
    <th>Price</th>
    <th>Stock</th>
    <th>Action</th>
    <th>Cost</th>
    <th>Edit</th>
</tr>
<% @products.each do |product| %>
    <tr>
        <td><%= product.title %></td>
        <td>€<%= product.price %></td>
        <td><%= product.stock %></td>
        <td>€<%= product.cost %></td>
        <td>
        <% if product.stock == 0 %> Out of Stock
        <% elsif product.stock <= 5 %> Low Stock
        <% else %> In Stock
        <% end %>
        </td>
        <td>
        <%= link_to "Edit", edit_store_product_path(@store, product) %>
        </td>
        </tr>
    <% end %>
</table>