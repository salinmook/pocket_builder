<h1>Order #<%= @order.id %></h1>
<% if @order.status == "cancelled" %>
<p style="color:red;">This order has been cancelled.</p>
<% end %>
<% @order.order_items.each do |item| %>
    <div style="border-bottom:1px solid #eee; padding:10px 0;">
        <p>Product: <%= item.product.title %></p>
        <p>Quantity: <%= item.quantity %></p>
        <p>Price: €<%= item.price %></p>
        <p>Subtotal: €<%= item.price * item.quantity %></p>
    </div>
<% end %>

<% subtotal = @order.order_items.sum { |i| i.price * i.quantity } %>
<p>Subtotal: €<%= subtotal %></p>
<% if @order.coupon.present? %>
    <p>Coupon Applied: <%= @order.coupon.code %></p>
    <p>Discount: -€<%= @order.discount_amount %></p>
<% end %>

<h3>Total: €<%= subtotal - @order.discount_amount %></h3>
<p>Status: <%= @order.status %></p>
<p>Date: <%= @order.created_at.strftime("%d/%m/%Y") %></p>

<h3>Shipping Details</h3>
<p>Name: <%= @order.shipping_name %></p>
<p>Phone: <%= @order.shipping_phone %></p>
<p>Address: <%= @order.shipping_address %></p>
<%= link_to "Back", orders_path %>