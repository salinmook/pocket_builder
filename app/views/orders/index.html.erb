<h1>My Orders</h1>
<% @orders.each do |order| %>
    <div style="border:1px solid #ddd; padding: 15px; margin-bottom: 20px;">

        <h3>Order #<%= order.id %></h3>
        <ul>
            <% order.order_items.each do |item| %>
            <li><%= item.product.title %> x <%= item.quantity %> - €<%= item.price * item.quantity %></li>
            <% end %>
        </ul>
        <% subtotal = order.order_items.sum { |i| i.price * i.quantity } %>
        
        <% if order.coupon.present? %>
            <p>Subtotal: €<%= subtotal %></p>
            <p>Coupon: <%= order.coupon.code %> (-€<%= order.discount_amount %>)</p>
        <% end %>
        <p><strong>Total: €<%= subtotal - order.discount_amount %></strong></p>
        <p>Status: <%= order.status %></p>
        <p>Date: <%= order.created_at.strftime("%d/%m/%Y") %></p>
    </div>
            
    <%= link_to "View", order_path(order) %>
    <% if order.status == "pending" %>
        <%= button_to "Cancel", cancel_order_path(order),
        method: :patch, 
        data: {
            turbo_confirm: "Are you sure you want to cancel this order?"
        } %>
    <% end %>
<% end %>