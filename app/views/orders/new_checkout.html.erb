<h1>Checkout</h1>
<h3>Order Summary</h3>
<% @cart.cart_items.includes(:product).each do |item| %>
    <p><%= item.product.title %> x <%= item.quantity %> - €<%= item.product.price * item.quantity %></p>
    <% end %>
    <p>Subtotal: €<%= @cart.subtotal %></p>
    <% if @cart.coupon.present? %>
        <p>Discount: -€<%= @cart.discount_amount %></p>
    <% end %>
    <h3>Total: €<%= @cart.total %></h3>
    <hr>
    <h3>Shipping Details</h3>
    <% if flash[:alert] %>
        <p style="color:red;"><%= flash[:alert] %></p>
    <% end %>

    <% if @selected_address %>
        <p>
            <strong><%= @selected_address.name %></strong><br>
            <%= @selected_address.address_line %><br>
            <%= @selected_address.phone %>
        </p>
        <%= link_to "Change delivery address", store_addresses_path(@store, checkout: true) %>

        <hr>
        <%= button_to "Confirm Order", checkout_path, method: :post, data: { turbo_confirm: "Confirm this order?" } %>
    <% else %>  
        <p>You don't have a delevery address yet.</p>
        <%= link_to "Add a delivery address", new_store_address_path(@store, checkout: true) %>
    <% end %>

        <hr>
        <%= link_to "Back to cart", cart_path(@cart) %>