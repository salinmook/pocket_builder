<h1>Edit Product</h1>
<%= form_with model: [@store, @product] do |f| %>
    <%= f.label :title %>
    <%= f.text_field :title %>

    <%= f.label :description %>
    <%= f.text_area :description %>

    <%= f.label :price %>
    <%= f.number_field :price, step:0.01 %>

    <%= f.label :stock %>
    <%= f.number_field :stock %>

    <%= f.label :image %>
        <% if @product.images.attached? %>
          <p>Current Images</p>
          <% @product.images.each do |image| %>
            <div>
            <%= image_tag image, width:150 %>

          <%= link_to "Remove Image", remove_image_store_product_path(@store, @product, image_id: image.id),
            data: {
            turbo_method: :delete,
            turbo_confirm: "Delete image?"
            } %>
            </div>
          <% end %>
        <% end %>

    <%= f.file_field :images, multiple:true %>

    <%= f.label :category %>
    <%= f.collection_select(:category_id, @store.categories, :id, :name) %>

    <%= f.submit "Update Product" %>
    <% end %>