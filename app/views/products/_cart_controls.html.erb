<%= turbo_frame_tag "product_#{product.id}" do %>
    <% cart_item = CartItem.find_by(cart_id: cart.id, product_id: product.id) %>

    <% if product.stock <= 0 %>
        <p style="color:red;"><strong>Out of Stock</strong></p>
    <% elsif cart_item %>
        <%= button_to "-", decrease_cart_item_path(cart_item), 
            method: :patch %>
        <strong>
        <%= cart_item.quantity %>
        </strong>
        <% if cart_item.quantity < product.stock %>
            <%= button_to "+", increase_cart_item_path(cart_item), 
                method: :patch %>

        <% else %>
            <span title="No more stock available">+</span>
        <%end %>
    <% else %>
        <%= button_to "Add to Cart", cart_items_path(product_id: product.id), 
            method: :post,
            data: { turbo_frame: "_top" } %>
    <% end %>
<% end %>
