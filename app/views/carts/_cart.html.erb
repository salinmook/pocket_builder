<%= turbo_frame_tag "cart" do %>
    <h1>Your Cart</h1>
    <% cart.cart_items.includes(:product).each do |item| %>
        <div style="border:1px solid #ddd; padding:10px; margin-bottom:10px;">
        <h3><%= item.product.title %></h3>
        <p>Price: €<%= item.product.price %></p>
        <p>Quantity: <%= item.quantity %></p>
        <p>Total: €<%= item.product.price * item.quantity %></p>

        <%= button_to "+", increase_cart_item_path(item),
        method: :patch %>

        <%= button_to "-", decrease_cart_item_path(item),
        method: :patch %>

        <%= button_to "Delete", cart_item_path(item),
        method: :delete,
        data: {
            turbo_confirm: "Remove item?" 
            } %>
        </div>
    <% end %>
    
    <hr>

    <% if cart.coupon.present? %>
        <p style="color:green;">
            Coupon <strong><%= cart.coupon.code %></strong> applied
            <%= button_to "Remove", remove_coupon_cart_path(cart),
            method: :delete, style: "display:inline; margin-left:8px" %>
        </p>
    <% else %>
        <%= form_with url: apply_coupon_cart_path(cart), method: :post, local: true do |f| %>
            <%= f.text_field :code, placeholder: "Promo code" %>
            <%= f.submit "Apply" %>
        <% end %>
    <% end %>

    <% if local_assigns[:cart_error].present? %>
        <p style="color:red;"><%= cart_error %></p>
    <% end %>

    <p>Subtotal: €<%= cart.subtotal %></p>
    <% if cart.coupon.present? %>
        <p>Discount: -€<%= cart.discount_amount %></p>
    <% end %>

    <h2>Total Cart: €<%= cart.total %></h2>
        <% if cart.cart_items.any? %>
            <%= button_to "Checkout", checkout_path,
            method: :post,
            data: {
                turbo_confirm: "Confirm order?",
                turbo_frame: "_top"
            } %>
        <% else %>
            <p>Your cart is empty</p>
        <% end %>
    <% end %>

