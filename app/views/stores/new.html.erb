<h1>Create Store</h1>
<%= form_with model: @store do |f| %>
    <%= f.label :name %>
    <%= f.text_field :name %>

    <%= f.label :description %>
    <%= f.text_area :description %>

    <%= f.label :theme %>
    <%= f.text_field :theme %>

    <%= f.submit %>
    <% end %>

    <%= link_to "Back to homepage", root_path %>
