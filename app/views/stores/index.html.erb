<h1>My Stores</h1>
<% @stores.each do |store| %>
    <div>
        <h3><%= store.name %></h3>
        <%= link_to "View Store", store_path(store) %>
        <%= link_to "dashboard", store_dashboard_path(store) %>
        <%= link_to "Edit", edit_store_path(store) %>
    </div>

    <% end %>

    

    <%= link_to "Create Store", new_store_path %>